# Copy to .env.postgres on the deployment host and keep mode 600.
NOVO_POSTGRES_DB=novo
NOVO_POSTGRES_USER=novo
NOVO_POSTGRES_PASSWORD=replace-with-a-url-safe-random-secret
NOVO_POSTGRES_CONTAINER_NAME=novo-postgres
NOVO_POSTGRES_DATA_DIR=/absolute/path/to/runtime/postgres
NOVO_POSTGRES_HOST_PORT=55432
NOVO_DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://novo:replace-with-the-same-secret@postgres:5432/novo
NOVO_APP_NETWORK=novo-eln_default
