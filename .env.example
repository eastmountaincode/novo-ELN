# Copy to .env.local before running Docker.
# Do not reuse this placeholder for a shared or public deployment.

ELN_SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Visible instance identity. Use "dev" for development/staging and "prod" for production.
NOVO_INSTANCE=prod

# Optional subtitle shown beneath the Novo-dev wordmark.
# NOVO_DEPLOYMENT_LABEL=AORUS2 development

# Optional ENEX import tuning.
# ENEX_IMPORT_WORKERS=4
