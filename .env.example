# Copy to .env.local before running Docker.
# Do not reuse this placeholder for a shared or public deployment.

ELN_SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Visible instance identity. Use "dev" for development/staging and "prod" for production.
NOVO_INSTANCE=prod

# Optional subtitle shown beneath the Novo-dev wordmark.
# NOVO_DEPLOYMENT_LABEL=AORUS2 development

# Optional Novo Chat companion integration. Leave both unset for ordinary Novo installs.
# Mount a separate, service-readable secret file into the container; do not put the
# secret itself or its host path in this service environment file. Deployment scripts
# read NOVO_INTEGRATION_SECRET_HOST_FILE from the invoking shell when this is enabled.
# NOVO_INTEGRATION_SECRET_FILE=/run/secrets/novo-integration
# NOVO_CHAT_URL=/chat/

# Optional ER Flow schema diagram sync. Leave unset for ordinary installs.
# Create your own ER Flow data model and store its MCP endpoint or UUID here.
# Treat this value as a write credential for that ER Flow model.
# ELN_ERFLOW_MODEL=https://app.erflow.io/mcp/data-model/YOUR_MODEL_UUID
# ELN_ERFLOW_VIEW_URL=https://app.erflow.io/share/YOUR_VIEW_ONLY_LINK

# Optional ENEX import tuning.
# ENEX_IMPORT_WORKERS=4
